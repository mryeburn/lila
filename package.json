{
  "name": "lila",
  "version": "0.1.0",
  "private": true,
  "description": "LILA Interactive Learning Assistant: a friendly AI tutor for learning anything.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "mammoth": "^1.13.0",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.19.2",
    "typebox": "1.3.27",
    "unpdf": "^1.9.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dompurify": "^3.2.3",
    "katex": "^0.16.11",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
